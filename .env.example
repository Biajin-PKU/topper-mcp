# ---- LLM (required) --------------------------------------------------------
# Any OpenAI-compatible /v1/chat/completions endpoint: OpenAI, a local vLLM or
# Ollama gateway, or a relay.
TOPPER_LLM_BASE_URL=https://api.openai.com/v1
TOPPER_LLM_API_KEY=
TOPPER_LLM_MODEL=gpt-4o-mini
# Tried in order when the primary model is unavailable.
TOPPER_LLM_FALLBACK_MODELS=
TOPPER_LLM_TIMEOUT_S=45

# ---- Paper sources ---------------------------------------------------------
# Semantic Scholar works without a key but throttles to roughly one request per
# few seconds. The key is free:
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# Several keys are pooled round-robin.
# SEMANTIC_SCHOLAR_API_KEYS=key1,key2

# OpenAlex needs no key, only a contact address (its politeness policy).
# Without it you share the slow anonymous pool.
OPENALEX_MAILTO=

# ---- Optional --------------------------------------------------------------
# Where CCF / CAS / JCR tables live. See topper/data/README.md.
# TOPPER_DATA_DIR=/path/to/tables
# TOPPER_CACHE_DIR=~/.cache/topper
# TOPPER_BRIEF_CACHE=1
# Second LLM pass that re-judges topical fit. Better precision, much slower.
# TOPPER_SELECTOR_LLM=0
